# label_tool 配置文件示例
# 支持多模型、多 provider

# 默认使用的模型
models:
  default: agnes-2.0-flash

# 各 API provider 配置
providers:
  agnes:
    base_url: https://apihub.agnes-ai.com/v1
    api_key: ${AGNES_API_KEY}  # 环境变量，也支持 "明文key"
    models:
      - name: agnes-2.0-flash
        max_tokens: 4096
        temperature: 0.7
        thinking_mode:
          enabled: false
          budget_tokens: 2048
      - name: agnes-2.0-pro
        max_tokens: 8192
        temperature: 0.7

  openai:
    base_url: https://api.openai.com/v1
    api_key: ${OPENAI_API_KEY}
    models:
      - name: gpt-4o
        max_tokens: 8192
        temperature: 0.7
      - name: gpt-4o-mini
        max_tokens: 4096
        temperature: 0.7

  ollama:
    base_url: http://localhost:11434/v1
    api_key: ollama  # Ollama 不需要 key
    models:
      - name: llama3
        max_tokens: 2048
        temperature: 0.1
